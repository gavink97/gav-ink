package layouts

import (
	c "github.com/gavink97/gav-ink/internal/components"
	m "github.com/gavink97/gav-ink/internal/middleware"
	"os"
)

templ Layout(contents templ.Component, title string) {
	@Head(title)
	if os.Getenv("env") == "prod" {
		@c.LoadingPage()
	}
	<body hx-ext="preload">
		@Nav()
		<main class="content" aria-label={ title }>
			@contents
		</main>
		@FooterWrapper(Footer())
	</body>
	<script src="/public/components/observer.js" nonce={ m.GetNonce(ctx) } defer></script>
}
