package layouts

import (
	m "github.com/gavink97/gav-ink/internal/middleware"
	"github.com/gavink97/gav-ink/internal/globals"
)

templ Head(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ title }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" type="image/png" href="/public/gav.png"/>
			<link rel="icon" type="image/svg" href="/public/gav.svg"/>
			if !globals.AirplaneMode {
				<link rel="preconnect" href="https://fonts.googleapis.com" nonce={ m.GetNonce(ctx) }/>
				<link rel="preconnect" href="https://fonts.gstatic.com" nonce={ m.GetNonce(ctx) } crossorigin/>
				<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" nonce={ m.GetNonce(ctx) }/>
			}
			<link rel="stylesheet" href="/public/css/main.css" nonce={ m.GetNonce(ctx) }/>
			<link rel="stylesheet" href="/public/effects/smoothscroll.css" nonce={ m.GetNonce(ctx) }/>
			<!-- Preload the LCP image with a high fetchpriority so it starts loading with the stylesheet. -->
			<link rel="preload" fetchpriority="high" as="image" href="/public/images/gavink.svg"/>
			<script src="/public/htmx.min.js" nonce={ m.GetNonce(ctx) } defer></script>
			<script src="/public/htmx.preload.js" nonce={ m.GetNonce(ctx) } defer></script>
			<script src="/public/effects/smoothscroll.js" nonce={ m.GetNonce(ctx) } defer></script>
			<script type="text/javascript" nonce={ m.GetNonce(ctx) } defer>
            (() => {
            const html = document.querySelector('html')
            if (!html) return;

            function setVH() {
                const clientHeight = window.innerHeight
                html.style.setProperty('--vh', String(clientHeight / 100));
            }

            function setVW() {
                const clientWidth = window.innerWidth
                html.style.setProperty('--vw', String(clientWidth / 100));
            }

            function client() {
                setVH()
                setVW()
            }

            client()

            window.addEventListener('resize', client);
            document.addEventListener('DOMContentLoaded', client);
            })()
            </script>
			/* initialize service worker
            <script type="text/javascript" nonce={ m.GetNonce(ctx) }>
                (() => {
                 if (navigator.serviceWorker) {
                    window.addEventListener('load', () => {
                        navigator.serviceWorker
                            .register('/public/components/serviceworker.js')
                            .then(reg => console.log('Service Worker Registered'))
                            .catch(swErr => console.log(
                                `Service Worker Installation Error: ${swErr}}`));
                    });
                 }
                 })()
            </script>
            */
			//<link rel="preload" href="/public/effects/pagetransition.js" as="script" nonce={ m.GetNonce(ctx) }/>
		</head>
	</html>
}
