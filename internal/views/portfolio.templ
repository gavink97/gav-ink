package views

import (
	"fmt"
	gh "github.com/gavink97/gav-ink/internal/github"
	m "github.com/gavink97/gav-ink/internal/middleware"
)

templ OpenSource(stats []gh.Repository) {
	<section aria-label="open source projects" class="half-section primary-text justify-end" id="projects">
		<h3 class="text-3xl">Open Source Projects & Contributions <span>🌱</span></h3>
		<p class="text-xl p-4">
			Open Source is a core tenet of our approach. We're greatful that we can sit on the shoulders giants and aim to cultivate
			our own garden of open source projects. It is here where we believe true innovation occurs.
		</p>
		@PortfolioTable(stats)
	</section>
	<script src="/public/components/table.js" type="module" nonce={ m.GetNonce(ctx) }></script>
}

// portfolio table on hover should display an image of the project
templ row(index int, repo gh.Repository) {
	if repo.Contribution {
		<li class="row" style={ fmt.Sprintf("grid-row: %d;", index+2) }>
			<a class="row" href={ templ.SafeURL(repo.Parent.Url) } target="_blank">
				<p class="col-1">{ repo.Parent.Name }<span>*</span></p>
				<p class="col-2">{ fmt.Sprint(repo.TimeCreated.Local().Year()) }</p>
				<p class="col-3">{ fmt.Sprintf("%d", repo.Parent.StargazersCount) } <span>⭐</span></p>
			</a>
		</li>
	} else {
		<li class="row" style={ fmt.Sprintf("grid-row: %d;", index+2) }>
			<a class="row" href={ templ.SafeURL(repo.Url) } target="_blank">
				<p class="col-1">{ repo.Name }</p>
				<p class="col-2">{ fmt.Sprint(repo.TimeCreated.Local().Year()) }</p>
				<p class="col-3">{ fmt.Sprintf("%d", repo.StargazersCount) } <span>⭐</span></p>
			</a>
		</li>
	}
}

// 3500 > 3.5k
templ PortfolioTable(stats []gh.Repository) {
	<ul class="table" style={ fmt.Sprintf("grid-template-rows: repeat(%d, 1fr);", len(stats)+2) } id="open-source-projects">
		<li class="row font-bold" style="grid-row: 1;">
			// on click change query
			<p class="col-1" id="table-button-project">Project</p>
			<p class="col-2" id="table-button-date">Date</p>
			<p class="col-3" id="table-button-stargazers">Stargazers</p>
		</li>
		for index, repo := range stats {
			@row(index, repo)
		}
		<li class="row" style={ fmt.Sprintf("grid-row: %d;", len(stats)+2) }>
			<p class="col-key text-xl">* open source contribution</p>
		</li>
	</ul>
}
