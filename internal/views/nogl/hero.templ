package views_nogl

import (
	"time"
	c "github.com/gavink97/gav-ink/internal/components"
)

func locTime(location string) string {
	loc, _ := time.LoadLocation(location)
	return time.Now().In(loc).Format("15:04:05")
}

templ Hero() {
	<section class="hero-grid primary-text" aria-label="hero" data-animation-trigger="hero">
		<div class="grid" style="grid-row: 1/6; grid-column: 1;">
			<div class="grid p-6" style="grid-row: 1; grid-column: 1;">
				<div style="grid-row: 1; grid-column: 2;" class="content-center text-center">
					<h1 class="text-lg">
						<span>
							Sustainable web design for everyone.
						</span>
					</h1>
				</div>
				<div class="hero-loc">
					<div class="flex gap-8">
						<div>
							<p>Austin</p>
							// time needs to be streamed
							// https://templ.guide/server-side-rendering/creating-an-http-server-with-templ
							<p>
								{ locTime("America/Chicago") }
							</p>
						</div>
						<div>
							<p>Jakarta</p>
							<p>
								{ locTime("Asia/Jakarta") }
							</p>
						</div>
						// current location
					</div>
					<div>Est. 2025</div>
				</div>
			</div>
			<a class="hero-img-container" style="grid-row: 2/5; grid-column: 1;" href="/#projects">
				<img src={ c.Image("projects.avif") } alt="projects preview" loading="lazy" class="hero-img"/>
				<p class="hero-button">Our Projects</p>
			</a>
		</div>
		<a class="hero-img-container" style="grid-row: 1/6; grid-column: 2;" href="/#services">
			<img src={ c.Image("services.avif") } alt="services preview" loading="lazy" class="hero-img"/>
			<p class="hero-button">Our Services</p>
		</a>
	</section>
}
