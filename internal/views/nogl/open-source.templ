package views_nogl

import (
	"fmt"
	c "github.com/gavink97/gav-ink/internal/components"
	gh "github.com/gavink97/gav-ink/internal/github"
	m "github.com/gavink97/gav-ink/internal/middleware"
)

templ OpenSource(stats []gh.Repository) {
	<section aria-label="open source projects" class="full-section-grid primary-text justify-end px-8" id="projects" data-animation-trigger="projects">
		<h3 class="section-subheader inline-block h-min self-end" style="grid-row: 1; grid-column: 1/3;">
			Open Source Projects & Contributions
			<span class="inline-flex">
				<img
					src={ c.Image("seedling.avif") }
					class="w-8 pl-1 md:w-12 md:pl-2 md:relative md:bottom-2"
					alt="seedling emoji"
					loading="lazy"
				/>
			</span>
		</h3>
		<p class="section-paragraph" style="grid-row: 2; grid-column: 1/3;">
			Open Source is a core tenet of our approach. We're grateful that we can stand on the shoulders of giants and aim to cultivate
			our own garden of open source projects. It is here where we believe true innovation occurs.
		</p>
		<ul class="table" style={ fmt.Sprintf("grid-template-rows: repeat(%d, 1fr); grid-row: 3/6; grid-column: 1/3;", len(stats)+2) } id="open-source-projects" data-column-active="table-button-date" data-column-order="asc">
			<li class="row font-bold" style="grid-row: 1;">
				<p class="col-1" id="table-button-project">Project</p>
				<p class="col-2" id="table-button-date">Date</p>
				<p class="col-3" id="table-button-stargazers">Stargazers</p>
			</li>
			@c.OpenSourceTable(stats)
			<li class="row" style={ fmt.Sprintf("grid-row: %d;", len(stats)+2) }>
				<p class="col-key text-xl">* open source contributions</p>
			</li>
		</ul>
	</section>
	<script src="/public/components/opensourcetable.js" type="module" nonce={ m.GetNonce(ctx) } defer></script>
}
