package components

import "strings"

import (
        m "github.com/gavink97/gav-ink/internal/middleware"
       )

templ StaggerText(text string) {
<stagger-text>
    @staggerTextSuspense(text)
    <div id="stagger">{text}</div>
    <script src="/public/effects/staggertext.js" type="module" nonce={ m.GetNonce(ctx) }></script>
</stagger-text>
}

templ staggerTextSuspense(text string) {
<div id="placeholder" class="stagger-suspense">
        for _, s := range strings.Split(text, "") {
            if s != " " {
                <span style="display: inline-block;">{s}</span>
                } else {
                <span style="display: inline-block; margin-right: 0.375rem;">{s}</span>
            }
        }
</div>
}
